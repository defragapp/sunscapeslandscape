#### Module A: Regrid GIS Fetch, CA State Plane Math & D1 Caching (`src/worker/services/gis-parcel.ts`)

```typescript
import proj4 from 'proj4';

// NAD83 / California Zone 5 (US Survey Feet) - EPSG:2229
const WGS84 = 'EPSG:4326';
const CA_STATE_PLANE_ZONE_5_FT =
  '+proj=lcc +lat_1=35.46666666666667 +lat_2=34.03333333333333 +lat_0=33.5 +lon_0=-118 +x_0=2000000.0001016 +y_0=500000.0001016001 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=us-ft +no_defs';

export interface LotSegment {
  segment: number;
  lengthFt: number;
  bearing: string;
  startX: number;
  startY: number;
  endX: number;
  endY: number;
}

export interface ParcelResult {
  id: string;
  address: string;
  apn: string;
  city: string;
  lotSqFt: number;
  wgs84Coordinates: [number, number][];
  segments: LotSegment[];
  isCached: boolean;
}

// Calculate compass bearing between two State Plane coordinate points
function calculateBearing(x1: number, y1: number, x2: number, y2: number): string {
  const theta = Math.atan2(x2 - x1, y2 - y1);
  let deg = (theta * 180) / Math.PI;
  if (deg < 0) deg += 360;

  const directions = ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'];
  const idx = Math.round(deg / 45) % 8;
  return `${deg.toFixed(1)}° (${directions[idx]})`;
}

export async function fetchAndCacheParcel(
  address: string,
  env: { DB: D1Database; REGRID_API_KEY?: string }
): Promise<ParcelResult> {
  const normalizedAddress = address.trim().toUpperCase();

  // 1. Check Cloudflare D1 Cache First (Zero API cost for repeat queries)
  const existing = await env.DB.prepare(
    `SELECT * FROM properties WHERE normalized_address = ?`
  ).bind(normalizedAddress).first<any>();

  if (existing) {
    return {
      id: existing.id,
      address: existing.display_address,
      apn: existing.apn,
      city: existing.city,
      lotSqFt: existing.lot_sqft,
      wgs84Coordinates: JSON.parse(existing.wgs84_polygon_json),
      segments: JSON.parse(existing.state_plane_segments_json),
      isCached: true,
    };
  }

  // 2. Fetch from Parcel API (e.g., Regrid GIS)
  const regridUrl = `https://app.regrid.com/api/v1/parcels/point?token=${env.REGRID_API_KEY || ''}&query=${encodeURIComponent(address)}`;
  let wgs84Coords: [number, number][] = [];
  let apn = 'UNKNOWN-APN';
  let city = 'Upland';
  let lotSqFt = 10000;

  try {
    const res = await fetch(regridUrl);
    if (res.ok) {
      const data: any = await res.json();
      const feature = data.features?.[0];
      if (feature?.geometry?.coordinates) {
        wgs84Coords = feature.geometry.coordinates[0];
        apn = feature.properties?.parcelnumb || apn;
        city = feature.properties?.city || city;
        lotSqFt = feature.properties?.ll_gisacre ? Math.round(feature.properties.ll_gisacre * 43560) : lotSqFt;
      }
    }
  } catch (err) {
    console.error('GIS API fetch failed, falling back to geometric default boundary', err);
  }

  // Fallback coordinates for testing if API key is not configured
  if (!wgs84Coords || wgs84Coords.length === 0) {
    wgs84Coords = [
      [-117.6512, 34.1021],
      [-117.6512, 34.1025],
      [-117.6504, 34.1025],
      [-117.6504, 34.1021],
      [-117.6512, 34.1021],
    ];
  }

  // 3. Project to California State Plane Zone 5 (US Survey Feet)
  const projectedPts = wgs84Coords.map((pt) => proj4(WGS84, CA_STATE_PLANE_ZONE_5_FT, pt));
  const originX = projectedPts[0][0];
  const originY = projectedPts[0][1];

  const localPts = projectedPts.map(([x, y]) => [
    Number((x - originX).toFixed(2)),
    Number((y - originY).toFixed(2)),
  ]);

  const segments: LotSegment[] = [];
  for (let i = 0; i < localPts.length - 1; i++) {
    const [x1, y1] = localPts[i];
    const [x2, y2] = localPts[i + 1];
    const dist = Number(Math.hypot(x2 - x1, y2 - y1).toFixed(2));
    const bearing = calculateBearing(x1, y1, x2, y2);
    segments.push({ segment: i + 1, lengthFt: dist, bearing, startX: x1, startY: y1, endX: x2, endY: y2 });
  }

  const propertyId = `prop_${crypto.randomUUID().slice(0, 8)}`;

  // 4. Cache Permanently in Cloudflare D1
  await env.DB.prepare(
    `INSERT INTO properties (
      id, normalized_address, display_address, city, apn, lot_sqft,
      wgs84_polygon_json, state_plane_segments_json, setbacks_applied_json, created_by
    ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`
  ).bind(
    propertyId,
    normalizedAddress,
    address,
    city,
    apn,
    lotSqFt,
    JSON.stringify(wgs84Coords),
    JSON.stringify(segments),
    JSON.stringify({ pool_side_rear_ft: 5, pool_house_ft: 6, equip_pad_ft: 3 }),
    'SYSTEM'
  ).run();

  return {
    id: propertyId,
    address,
    apn,
    city,
    lotSqFt,
    wgs84Coordinates: wgs84Coords,
    segments,
    isCached: false,
  };
}

