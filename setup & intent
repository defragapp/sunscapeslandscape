#### Module C: Client-Side Three.js LiDAR OBJ-to-USDZ Converter & Apple AR Quick Look (`src/client/components/ArLidarBridge.tsx`)

This component takes an `.obj` or `.fbx` iPhone LiDAR scan captured in the yard, renders it in 3D using Three.js, exports it as an Apple `.usdz` file for iPhone AR Quick Look, and uploads both `.glb` and `.usdz` to Cloudflare R2:

```tsx
import React, { useState } from 'react';
import * as THREE from 'three';
import { OBJLoader } from 'three/examples/jsm/loaders/OBJLoader';
import { USDZExporter } from 'three/examples/jsm/exporters/USDZExporter';
import { GLTFExporter } from 'three/examples/jsm/exporters/GLTFExporter';

interface ArLidarBridgeProps {
  propertyId: string;
  address: string;
  onUploadComplete: (glbR2Key: string, usdzR2Key: string) => void;
}

export const ArLidarBridge: React.FC<ArLidarBridgeProps> = ({
  propertyId,
  address,
  onUploadComplete,
}) => {
  const [isProcessing, setIsProcessing] = useState(false);
  const [statusText, setStatusText] = useState('');
  const [usdzDownloadUrl, setUsdzDownloadUrl] = useState<string | null>(null);

  const handleFileUpload = async (event: React.ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;

    setIsProcessing(true);
    setStatusText('Reading 3D scan from iPhone LiDAR...');

    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const contents = e.target?.result as string;
        const objLoader = new OBJLoader();
        const objScene = objLoader.parse(contents);

        // Normalize scale and orientation for VIP3D and Apple AR
        objScene.traverse((child) => {
          if ((child as THREE.Mesh).isMesh) {
            const mesh = child as THREE.Mesh;
            mesh.material = new THREE.MeshStandardMaterial({
              color: 0xe0d7c6, // Sandstone / Travertine tone
              roughness: 0.8,
            });
          }
        });

        setStatusText('Generating Apple USDZ file with 1:1 scale LiDAR calibration...');
        const usdzExporter = new USDZExporter();
        const usdzArrayBuffer = await usdzExporter.parse(objScene);

        setStatusText('Generating GLB Web 3D file for desktop preview...');
        const gltfExporter = new GLTFExporter();
        const glbArrayBuffer = await new Promise<ArrayBuffer>((resolve) => {
          gltfExporter.parse(
            objScene,
            (gltf) => resolve(gltf as ArrayBuffer),
            { binary: true }
          );
        });

        setStatusText('Streaming optimized 3D assets to Cloudflare R2...');

        // Upload USDZ to Worker API
        const usdzFormData = new FormData();
        usdzFormData.append('file', new Blob([usdzArrayBuffer], { type: 'model/vnd.usdz+zip' }));
        usdzFormData.append('key', `projects/${propertyId}/scan-model.usdz`);

        const glbFormData = new FormData();
        glbFormData.append('file', new Blob([glbArrayBuffer], { type: 'model/gltf-binary' }));
        glbFormData.append('key', `projects/${propertyId}/scan-model.glb`);

        await Promise.all([
          fetch('/api/upload-asset', { method: 'POST', body: usdzFormData }),
          fetch('/api/upload-asset', { method: 'POST', body: glbFormData }),
        ]);

        const usdzUrl = `/api/assets/projects/${propertyId}/scan-model.usdz`;
        setUsdzDownloadUrl(usdzUrl);
        onUploadComplete(`projects/${propertyId}/scan-model.glb`, `projects/${propertyId}/scan-model.usdz`);
        setStatusText('Complete! 3D scan ready for VIP3D and iPhone AR placement.');
      } catch (err: any) {
        setStatusText(`Error processing 3D scan: ${err.message}`);
      } finally {
        setIsProcessing(false);
      }
    };

    reader.readAsText(file);
  };

  return (
    <div className="rounded-xl border border-stone-200 bg-[#FAF8F5] p-5">
      <div className="flex items-center justify-between border-b border-stone-200 pb-3">
        <div>
          <span className="text-xs font-bold uppercase tracking-wider text-[#D97706]">
            LiDAR Field-to-VIP3D Bridge • CA Lic #767000
          </span>
          <h4 className="text-base font-semibold text-[#1B4332]">iPhone Backyard 3D Scan Ingestion</h4>
        </div>
      </div>

      <p className="mt-2 text-xs text-stone-600">
        Upload an `.obj` or `.fbx` file captured on iPhone Pro / iPad Pro (Scaniverse, Polycam, or Apple Measure). 
        The system scales it to 1:1, binds it to the address record, and generates the VIP3D import bundle.
      </p>

      <div className="mt-4 flex flex-wrap items-center gap-3">
        <label className="cursor-pointer rounded-lg bg-[#1B4332] px-4 py-2 text-sm font-semibold text-white shadow hover:bg-emerald-900">
          <span>{isProcessing ? 'Processing 3D Geometry...' : '📱 Select iPhone LiDAR File (.obj)'}</span>
          <input
            type="file"
            accept=".obj,.fbx"
            onChange={handleFileUpload}
            disabled={isProcessing}
            className="hidden"
          />
        </label>

        {usdzDownloadUrl && (
          <a
            rel="ar"
            href={`${usdzDownloadUrl}#allowsContentScaling=0`}
            className="inline-flex items-center gap-2 rounded-lg border border-[#D97706] bg-amber-50 px-4 py-2 text-sm font-bold text-[#D97706] hover:bg-amber-100"
          >
            <span>📱 Test 1:1 AR Placement on iPhone</span>
          </a>
        )}
      </div>

      {statusText && <p className="mt-3 text-xs font-medium text-stone-700">{statusText}</p>}
    </div>
  );
};

