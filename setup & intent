### 3. `src/worker/services/dxf-vip3d.ts` (VIP3D CAD Generator with Sunscapes Title Block)

Converts parcel coordinates into California State Plane Zone 5 (`EPSG:2229` feet) and writes a clean ASCII `.dxf` file containing both the property boundary on the `SUNSCAPES_PARCEL` layer and a branded **Sunscapes Landscape Company Title Block** on the `SUNSCAPES_TITLEBLOCK` layer:

```typescript
import proj4 from 'proj4';

// Define WGS84 to NAD83 / California Zone 5 (ftUS) - Inland Empire / SoCal
const WGS84 = 'EPSG:4326';
const CA_ZONE_5_FT = '+proj=lcc +lat_1=35.46666666666667 +lat_2=34.03333333333333 +lat_0=33.5 +lon_0=-118 +x_0=2000000.0001016 +y_0=500000.0001016001 +ellps=GRS80 +towgs84=0,0,0,0,0,0,0 +units=us-ft +no_defs';

export interface LotSegment {
  segmentIndex: number;
  lengthFt: number;
  startX: number;
  startY: number;
  endX: number;
  endY: number;
}

export function generateSunscapesVip3dDxf(
  coordsLngLat: [number, number][],
  address: string,
  apn: string,
  designerName: string
): { dxfContent: string; segments: LotSegment[] } {
  // Project all coordinates to local State Plane Feet, zeroed to the first corner
  const projected = coordsLngLat.map((pt) => proj4(WGS84, CA_ZONE_5_FT, pt));
  const originX = projected[0][0];
  const originY = projected[0][1];

  const localPts = projected.map(([x, y]) => [
    Number((x - originX).toFixed(2)),
    Number((y - originY).toFixed(2))
  ]);

  const segments: LotSegment[] = [];
  for (let i = 0; i < localPts.length - 1; i++) {
    const [x1, y1] = localPts[i];
    const [x2, y2] = localPts[i + 1];
    const dist = Number(Math.hypot(x2 - x1, y2 - y1).toFixed(2));
    segments.push({ segmentIndex: i + 1, lengthFt: dist, startX: x1, startY: y1, endX: x2, endY: y2 });
  }

  let dxf = `0\nSECTION\n2\nENTITIES\n`;

  // 1. Draw Closed Parcel Boundary (Layer: SUNSCAPES_PARCEL)
  for (const seg of segments) {
    dxf += `0\nLINE\n8\nSUNSCAPES_PARCEL\n10\n${seg.startX}\n20\n${seg.startY}\n30\n0.0\n11\n${seg.endX}\n21\n${seg.endY}\n31\n0.0\n`;
    // Midpoint Dimension Callout (Layer: SUNSCAPES_DIMS)
    const midX = ((seg.startX + seg.endX) / 2).toFixed(2);
    const midY = ((seg.startY + seg.endY) / 2).toFixed(2);
    dxf += `0\nTEXT\n8\nSUNSCAPES_DIMS\n10\n${midX}\n20\n${midY}\n30\n0.0\n40\n2.5\n1\n${seg.lengthFt}'\n`;
  }

  // 2. Draw Branded Title Block Offset to Bottom-Right (Layer: SUNSCAPES_TITLEBLOCK)
  const tbX = 120;
  const tbY = -40;
  const dateStr = new Date().toISOString().split('T')[0];
  const titleLines = [
    `SUNSCAPES LANDSCAPE COMPANY | CA LIC #767000`,
    `1529 W. 13th St, Suite D, Upland, CA 91786 | 1-877-SCAPES1`,
    `PROJECT: ${address.toUpperCase()}`,
    `APN: ${apn} | SCALE: 1 UNIT = 1 FT (CA ZONE 5)`,
    `PREPARED BY: ${designerName} | DATE: ${dateStr}`
  ];

  titleLines.forEach((line, idx) => {
    dxf += `0\nTEXT\n8\nSUNSCAPES_TITLEBLOCK\n10\n${tbX}\n20\n${tbY - idx * 3.5}\n30\n0.0\n40\n2.0\n1\n${line}\n`;
  });

  dxf += `0\nENDSEC\n0\nEOF\n`;
  return { dxfContent: dxf, segments };
}

```

### 4. `src/worker/index.ts` (Hono API with Cloudflare AI Gateway & Recall Logic)

Routes employee prompts through **Cloudflare AI Gateway** (`sunscapes-ai-gateway`), checks D1 for existing property records, and returns instant asset links:

```typescript
import { Hono } from 'hono';
import { generateSunscapesVip3dDxf } from './services/dxf-vip3d';

type Bindings = {
  AI: Ai;
  DB: D1Database;
  BUCKET: R2Bucket;
  VECTORIZE: VectorizeIndex;
  AI_GATEWAY_ID: string;
};

const app = new Hono<{ Bindings: Bindings }>();

// 1. Persistent Company-Wide AI Chat & Address Recall Endpoint
app.post('/api/chat', async (c) => {
  const { message, address, userEmail } = await c.req.json();

  // Check if address already exists in Sunscapes D1 Database
  let propertyRecord = null;
  if (address) {
    propertyRecord = await c.env.DB.prepare(
      `SELECT * FROM properties WHERE normalized_address = ?`
    ).bind(address.trim().toUpperCase()).first();
  }

  // Query Vectorize for local Inland Empire City Setback rules
  const embedding = await c.env.AI.run(
    '@cf/baai/bge-base-en-v1.5',
    { text: [message] },
    { gateway: { id: c.env.AI_GATEWAY_ID } }
  );
  const setbackMatches = await c.env.VECTORIZE.query(embedding.data[0], { topK: 3, returnMetadata: true });
  const zoningContext = setbackMatches.matches.map((m) => m.metadata?.text || '').join('\n');

  // Run Llama 3.3 via Cloudflare AI Gateway with persistent company context
  const systemPrompt = `You are the Sunscapes Landscape Company Internal Engineering & Design Assistant (Upland, CA | Lic #767000 | 1-877-SCAPES1).
  Known Property Data from D1: ${propertyRecord ? JSON.stringify(propertyRecord) : 'None yet - prompt user to click Fetch Parcel if needed.'}
  Local Municipal Setback Rules: ${zoningContext}
  Provide concise, field-ready measurements, pool/patio setback guidance, and VIP3D import instructions.`;

  const aiResponse = await c.env.AI.run(
    '@cf/meta/llama-3.3-70b-instruct-fp8-fast',
    {
      messages: [
        { role: 'system', content: systemPrompt },
        { role: 'user', content: message }
      ]
    },
    { gateway: { id: c.env.AI_GATEWAY_ID, skipCache: false } }
  );

  return c.json({
    reply: aiResponse.response,
    cachedProperty: propertyRecord
  });
});

// 2. Seamless 1024x1024 VIP3D Texture Generator via Flux
app.post('/api/texture', async (c) => {
  const { materialPrompt, name } = await c.req.json();
  const enhancedPrompt = `Seamless tileable architectural texture of ${materialPrompt}, flat orthographic top-down lighting, no shadows, photorealistic PBR material for 3D landscape rendering, 1024x1024`;

  const imgStream = await c.env.AI.run(
    '@cf/black-forest-labs/flux-1-schnell',
    { prompt: enhancedPrompt, steps: 4 },
    { gateway: { id: c.env.AI_GATEWAY_ID } }
  );

  const r2Key = `textures/${Date.now()}-${name.replace(/\s+/g, '-').toLowerCase()}.png`;
  await c.env.BUCKET.put(r2Key, imgStream, {
    httpMetadata: { contentType: 'image/png' }
  });

  return c.json({ textureUrl: `/api/assets/${r2Key}`, r2Key });
});

export default app;

```

